{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "fix": "eslint . --fix --max-warnings 0 && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit --watch",
    "test:update": "vitest run tests/unit -u",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test:property": "vitest run --testNamePattern=.prop.test.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/leaflet": "^1.9.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-testing-library": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^26.1.0",
    "fast-check": "^4.7.0",
    "postcss": "^8.5.8",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "storybook": "^8.6.14",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.2",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.5",
    "vite": "^8.0.1"
  }
}
